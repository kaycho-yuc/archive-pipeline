INBOX_DIR=_inbox
ARCHIVE_DIR=_archive
FAILED_DIR=_failed
OBSIDIAN_VAULT_PATH_MAC=
OBSIDIAN_VAULT_PATH_WIN=
OLLAMA_MODEL=llama3.1
# 모델 접속 주소. 시스템 OLLAMA_HOST 가 0.0.0.0 인 경우를 위해 명시.
OLLAMA_HOST=127.0.0.1:11434
# 처리 결과 CSV 로그 경로
PROCESSING_LOG=processing_log.csv
# 업무 노트 frontmatter 의 project 기본값
DEFAULT_WORK_PROJECT=성수동 리모델링
# 이 프로젝트의 식별자(쉼표 구분). 분류기가 '프로젝트 실데이터 vs 참고자료'를 판단할 때 사용.
PROJECT_IDENTIFIERS=685-317,685-383,성수동1가
# 참고자료(템플릿·샘플·정부지침·다른 현장) 격리 폴더. 비우면 _failed/참고자료.
REFERENCE_DIR=
# 실패 알림용 텔레그램 + RAG 봇 (비우면 비활성화)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 봇 답변 모델(한국어 특화, 벤치마크로 선정)
TELEGRAM_RAG_MODEL=exaone3.5:7.8b
# RAG 백엔드: local(기본, LanceDB+bge-m3, Docker 불필요) 또는 openwebui(구 경로)
RAG_BACKEND=local
# 로컬 RAG 임베딩 모델(다국어). ollama pull bge-m3 필요.
RAG_EMBED_MODEL=bge-m3
# --- 아래 OPENWEBUI_* 는 RAG_BACKEND=openwebui 일 때만 필요 ---
OPENWEBUI_URL=http://127.0.0.1:3000
# Open WebUI → 설정 → 계정 → API 키
OPENWEBUI_API_KEY=
# 지식베이스 ID (ingest_vault.py 최초 실행 시 생성되어 출력됨)
OPENWEBUI_KB_ID=
# 주의: Open WebUI 기본 임베더는 all-MiniLM-L6-v2(영어)라 한국어 검색이 약하다.
# 그래서 local 백엔드(bge-m3)가 기본이다.
